# 复制为 .env 后填写，.env 本身不要提交进 git（CLAUDE.md Security 一节已强调这点）
# tmp.md 里曾经明文出现过密码，上线前记得清理 git 历史并轮换

# ---------- MySQL 主库（VQMS 管理 + 派生统计，唯一持久库，v3.1 §1.4）----------
MYSQL_ROOT_PASSWORD=change_me_root_pw
MYSQL_DATABASE=ry_vqms

# 最小权限应用账号（v3.1 §9）：root 只用于首次建库建表建号，
# 后端运行时连库用这个账号，只有该库的增删改查权限，没有 DDL/GRANT/跨库权限。
# 由 RuoYi-Vue-springboot3/sql/00-create-app-user.sh 在首次启动时自动创建，无需手动执行 SQL。
DB_USER=vqms_app
DB_PASSWORD=change_me_app_pw

# ---------- Redis（RuoYi 硬依赖：token/验证码/限流/字典缓存）----------
REDIS_PASSWORD=change_me_redis_pw

# ---------- JWT ----------
# 至少 32 位随机字符串，不要用 application.yml 里自带的示例值
JWT_SECRET=change_me_to_a_long_random_secret

# ---------- 外部只读数据源（10.0.0.9，现 MySQL 5.7，v3.1 §5.3）----------
# M0 阶段可以先不填；M1 接入 ruoyi-vqms/source 时才会真正用到
SOURCE_HOST=10.0.0.9
SOURCE_PORT=3306
SOURCE_DB=qheatavchisdb
SOURCE_USERNAME=change_me
SOURCE_PASSWORD=change_me
