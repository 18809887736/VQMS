# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
# stray download archives
*.zip

# backup/ 保留脚手架原始压缩包归档（与已解压源码并存的纯净版本）
!backup/*.zip

# docker-compose 部署凭据（根目录 .env，含明文密码，绝不提交）
/.env

# DSH 会话上传暂存（用户拖拽附件，内容不可控，绝不提交）
/.dsh/

# jqwik 失败记忆数据库（序列化二进制，测试运行产物；已在 surefire 禁用）
.jqwik-database

# 现场数据库导出（大文件、可能含敏感数据，绝不提交）
/docs/外部DB/现场/
