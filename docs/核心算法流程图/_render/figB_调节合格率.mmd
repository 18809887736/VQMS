graph TD
    classDef s1 fill:#f3e8ff,stroke:#6b21a8,stroke-width:2px,color:#000
    classDef s2 fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#000
    classDef gate fill:#fef9c3,stroke:#a16207,stroke-width:2px,color:#000
    classDef pass fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#000
    classDef fail fill:#fecaca,stroke:#b91c1c,stroke-width:2px,color:#000
    classDef skip fill:#f1f5f9,stroke:#64748b,stroke-width:1px,color:#000
    classDef out fill:#fce7f3,stroke:#be185d,stroke-width:2px,color:#000

    Start(["一道 AVC 调压指令"]) --> A1

    subgraph 解码 ["① 算出这道指令的目标电压"]
        A1["把指令翻译成<br/>「要把电压调到多少 kV」"]:::s1
        A1 --> A2{"能算出来吗？"}:::gate
        A2 -->|"翻译失败 / 数据缺失"| S1["这道指令跳过<br/>不计数"]:::skip
        A2 -->|"算得出"| A3["目标电压 V"]:::s2
    end

    A3 --> B1

    subgraph 对齐 ["② 取这一段电压曲线（按分钟）"]
        B1["以下令时刻为起点<br/>取后面每分钟的最高/最低电压"]:::s2
    end

    B1 --> C1
    B1 --> D1

    subgraph 快速窗 ["③ 快速性档（短窗口，约前 5 分钟）—— 考「调得快不快」"]
        C1["把短窗口里每分钟<br/>最高/最低电压并起来<br/>得到一个总范围"]:::s2
        C1 --> C2{"目标电压落进<br/>这个短窗口范围了吗？"}:::gate
        C2 -->|"落进去了"| Q1["✅ 快速性合格<br/>调得快"]:::pass
        C2 -->|"没落进去"| CF1{"免考吗？<br/>设备都顶满了<br/>还是调不动？"}:::gate
        CF1 -->|"是（设备已尽力）"| QF1["快速性免考<br/>剔除：不算不罚"]:::skip
        CF1 -->|"否 / 拿不到数据"| QF2["❌ 快速性不合格，罚"]:::fail
    end

    subgraph 经济窗 ["④ 经济性档（长窗口，约 5~30 分钟）—— 考「最终调到位没」<br/>★ 与 ③ 平行、各自独立，不靠 ③ 的结果 ★"]
        D1["把长窗口里每分钟<br/>最高/最低电压并起来<br/>得到一个总范围"]:::s2
        D1 --> D2{"目标电压落进<br/>这个长窗口范围了吗？"}:::gate
        D2 -->|"落进去了"| Q2["✅ 经济性合格<br/>最终调到位"]:::pass
        D2 -->|"没落进去"| DF1{"免考吗？<br/>设备都顶满了<br/>还是调不动？"}:::gate
        DF1 -->|"是（设备已尽力）"| QE1["经济性免考<br/>剔除：不算不罚"]:::skip
        DF1 -->|"否 / 拿不到数据"| QE2["❌ 经济性不合格，罚"]:::fail
    end

    Q1 --> RF0
    QF1 --> RF0
    QF2 --> RF0
    Q2 --> RE0
    QE1 --> RE0
    QE2 --> RE0

    subgraph 统计 ["⑤ 两档各自算账（互不掺和）"]
        RF0["【快速性】有效 = 总发令 − 快速性免考<br/>快速性合格率 = 快速性合格数 ÷ 有效"]:::out
        RE0["【经济性】有效 = 总发令 − 经济性免考<br/>经济性合格率 = 经济性合格数 ÷ 有效"]:::out
        RF0 --> RF1["快速性罚款 = 缺的百分点 × 机组容量 × 0.02 分/万千瓦"]:::fail
        RE0 --> RE1["经济性罚款 = 缺的百分点 × 机组容量 × 0.02 分/万千瓦"]:::fail
        RF1 --> SUM["总罚款 = 快速性罚款 + 经济性罚款<br/>（两个合格率分开看，不合并成一个数）"]:::out
        RE1 --> SUM
        SUM --> EX["举例：发令 100 次<br/>快速性：免考 3、罚 7 → 缺 7.2 点<br/>经济性：免考 5、罚 5 → 缺 5.3 点<br/>→ 两个档各罚各的，相加得总罚款"]:::out
    end

    EX --> End(["结束：快速性合格率 / 经济性合格率 / 总罚款"])

